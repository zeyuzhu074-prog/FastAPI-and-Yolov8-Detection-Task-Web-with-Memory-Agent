# Copy this file to visdrone.yaml and edit dataset paths.
# Ultralytics expects image folders and corresponding YOLO label folders.
path: E:/datasets/VisDrone
train: images/train
val: images/val
test: images/test

# Common VisDrone-DET class names (check the exact label mapping in your dataset!)
names:
  0: pedestrian
  1: people
  2: bicycle
  3: car
  4: van
  5: truck
  6: tricycle
  7: awning-tricycle
  8: bus
  9: motor
